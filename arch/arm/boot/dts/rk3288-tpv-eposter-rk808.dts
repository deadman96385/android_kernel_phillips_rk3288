	compatible = "simple-panel";
	backlight = <&backlight>;
	enable-gpios = <&gpio7 4 GPIO_ACTIVE_HIGH>;
	enable-delay-ms = <120>;
	pinctrl-0 = <&lcd_cs>;
	power-supply = <&vcc_io>;
