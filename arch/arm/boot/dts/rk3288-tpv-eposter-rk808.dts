&dsi0 {
	status = "okay";
	//rockchip,lane-rate = <900>;

	panel: panel@0  {
		compatible = "simple-panel-dsi";
		reg = <0>;
		backlight = <&backlight>; 
		lcd-cs-gpios = <&gpio0 14 GPIO_ACTIVE_LOW>;
		//power-supply = <&vcc_io>;
		cs-gpios = <&gpio8 7 GPIO_ACTIVE_HIGH>; 
		enable-gpios = <&gpio8 6 GPIO_ACTIVE_LOW>;
		reset-gpios = <&gpio6 5 GPIO_ACTIVE_LOW>;
		dsi,flags = <(MIPI_DSI_MODE_VIDEO | MIPI_DSI_MODE_VIDEO_BURST | MIPI_DSI_MODE_LPM | MIPI_DSI_MODE_EOT_PACKET)>;
		dsi,format = <MIPI_DSI_FMT_RGB888>;
		dsi,lanes = <4>;
		reset-delay-ms = <20>;
		init-delay-ms = <120>;
		enable-delay-ms = <120>;
		prepare-delay-ms = <20>;
		unprepare-delay-ms = <120>;
		disable-delay-ms = <120>;
		pinctrl-names = "default";
		pinctrl-0 = <&dsi_drv>;
		status = "okay";

		//DCS Packet
		panel-init-sequence = [
			//Page 0
			15 00 02 E0 00
			//--- PASSWORD  ----//
			15 00 02 E1 93
			15 00 02 E2 65
			15 00 02 E3 F8
			15 00 02 80 03
			//--- Page1  ----//
			15 00 02 E0 01
			//Set VCOM
			15 00 02 01 67
			//Set Gamma Power, VGMP,VGMN,VGSP,VGSN
			15 00 02 17 00
			15 00 02 18 BF//4.5V, D7=4.8V
			15 00 02 19 01//0.0V
			15 00 02 1A 00
			15 00 02 1B BF
			15 00 02 1C 01
			15 00 02 0C 74			                
			//Set Gate Power
			15 00 02 1F 70	//VGH_REG=16.2V
			15 00 02 20 2D	//VGL_REG=-12V
			15 00 02 21 2D	//VGL_REG2=-12V
			15 00 02 22 7E
			15 00 02 0C 74	
			15 00 02 35 28	//SAP
			15 00 02 37 19	//SS=1,BGR=1
			//SET RGBCYC
			15 00 02 38 05	//JDT=101 zigzag inversion
			15 00 02 39 00
			15 00 02 3A 01
			15 00 02 3C 7C	//SET EQ3 for TE_H
			15 00 02 3D FF	//SET CHGEN_ON, modify 20140806 
			15 00 02 3E FF	//SET CHGEN_OFF, modify 20140806 
			15 00 02 3F 7F	//SET CHGEN_OFF2, modify 20140806
			//Set TCON
			15 00 02 40 06	//RSO=
			15 00 02 41 A0	//LN=640->1280 line
			15 00 02 43 1E	//VFP=30
			15 00 02 44 0B	//VBP=12
			15 00 02 45 28  //HBP=40
			//--- power voltage  ----//
			15 00 02 55 01	
			15 00 02 57 A9
			//15 00 02 58 0A
			15 00 02 59 0A	//VCL = -2.5V
			15 00 02 5A 2E	//VGH = 16.2V
			15 00 02 5B 1A	//VGL = -12V
			15 00 02 5C 15	//pump clk
			//--- Gamma  ----//
			15 00 02 5D 7F
			15 00 02 5E 64
			15 00 02 5F 53
			15 00 02 60 47
			15 00 02 61 43
			15 00 02 62 33
			15 00 02 63 37
			15 00 02 64 21
			15 00 02 65 39
			15 00 02 66 37
			15 00 02 67 34
			15 00 02 68 50
			15 00 02 69 3D
			15 00 02 6A 44
			15 00 02 6B 36
			15 00 02 6C 34
			15 00 02 6D 25
			15 00 02 6E 15
			15 00 02 6F 02
			15 00 02 70 7F
			15 00 02 71 64
			15 00 02 72 53
			15 00 02 73 47
			15 00 02 74 43
			15 00 02 75 33
			15 00 02 76 37
			15 00 02 77 21
			15 00 02 78 39
			15 00 02 79 37
			15 00 02 7A 34
			15 00 02 7B 50
			15 00 02 7C 3D
			15 00 02 7D 44
			15 00 02 7E 36
			15 00 02 7F 34
			15 00 02 80 25
			15 00 02 81 15
			15 00 02 82 02
			//Page2, for GIP
			15 00 02 E0 02
			//GIP_L Pin mapping
			15 00 02 00 52 //RESET_EVEN
			15 00 02 01 55 //VSSG_EVEN 
			15 00 02 02 55 //VSSG_EVEN 
			15 00 02 03 50 //STV2_ODD  
			15 00 02 04 77 //VDD2_ODD  
			15 00 02 05 57 //VDD1_ODD  
			15 00 02 06 55 //x         
			15 00 02 07 4E //CK11      
			15 00 02 08 4C //CK9       
			15 00 02 09 5F //x         
			15 00 02 0A 4A //CK7       
			15 00 02 0B 48 //CK5       
			15 00 02 0C 55 //x         
			15 00 02 0D 46 //CK3       
			15 00 02 0E 44 //CK1       
			15 00 02 0F 40 //STV1_ODD  
			15 00 02 10 55 //x         
			15 00 02 11 55 //x         
			15 00 02 12 55 //x         
			15 00 02 13 55 //x         
			15 00 02 14 55 //x         
			15 00 02 15 55 //x         
			//GIP_R Pin mapping
			15 00 02 16 53 //RESET__EVEN
			15 00 02 17 55 //VSSG_EVEN  
			15 00 02 18 55 //VSSG_EVEN  
			15 00 02 19 51 //STV2_EVEN  
			15 00 02 1A 77 //VDD2_EVEN  
			15 00 02 1B 57 //VDD1_EVEN  
			15 00 02 1C 55 //x          
			15 00 02 1D 4F //CK12       
			15 00 02 1E 4D //CK10       
			15 00 02 1F 5F //x          
			15 00 02 20 4B //CK8        
			15 00 02 21 49 //CK6        
			15 00 02 22 55 //x          
			15 00 02 23 47 //CK4        
			15 00 02 24 45 //CK2        
			15 00 02 25 41 //STV1_EVEN  
			15 00 02 26 55 //x          
			15 00 02 27 55 //x          
			15 00 02 28 55 //x          
			15 00 02 29 55 //x          
			15 00 02 2A 55 //x          
			15 00 02 2B 55 //x          
			//GIP_L_GS Pin mapping
			15 00 02 2C 13 //RESET_EVEN     
			15 00 02 2D 15 //VSSG_EVEN         
			15 00 02 2E 15 //VSSG_EVEN       
			15 00 02 2F 01 //STV2_ODD        
			15 00 02 30 37 //VDD2_ODD        
			15 00 02 31 17 //VDD1_ODD        
			15 00 02 32 15 //x               
			15 00 02 33 0D //CK11            
			15 00 02 34 0F //CK9             
			15 00 02 35 15 //x               
			15 00 02 36 05 //CK7             
			15 00 02 37 07 //CK5             
			15 00 02 38 15 //x               
			15 00 02 39 09 //CK3             
			15 00 02 3A 0B //CK1             
			15 00 02 3B 11 //STV1_ODD        
			15 00 02 3C 15 //x               
			15 00 02 3D 15 //x               
			15 00 02 3E 15 //x               
			15 00 02 3F 15 //x               
			15 00 02 40 15 //x               
			15 00 02 41 15 //x              			                                       
			//GIP_R_GS Pin mapping                 
			15 00 02 42 12 //RESET__EVEN    
			15 00 02 43 15 //VSSG_EVEN         
			15 00 02 44 15 //VSSG_EVEN       
			15 00 02 45 00 //STV2_EVEN       
			15 00 02 46 37 //VDD2_EVEN       
			15 00 02 47 17 //VDD1_EVEN       
			15 00 02 48 15 //x               
			15 00 02 49 0C //CK12            
			15 00 02 4A 0E //CK10            
			15 00 02 4B 15 //x               
			15 00 02 4C 04 //CK8             
			15 00 02 4D 06 //CK6             
			15 00 02 4E 15 //x               
			15 00 02 4F 08 //CK4             
			15 00 02 50 0A //CK2              
			15 00 02 51 10 //STV1_EVEN       
			15 00 02 52 15 //x               
			15 00 02 53 15 //x               
			15 00 02 54 15 //x               
			15 00 02 55 15 //x               
			15 00 02 56 15 //x               
			15 00 02 57 15 //x               
			//GIP Timing  
			15 00 02 58 40
			15 00 02 5B 10 
			15 00 02 5C 06 //STV_S0 
			15 00 02 5D 40
			15 00 02 5E 00 
			15 00 02 5F 00 
			15 00 02 60 40 //ETV_W 
			15 00 02 61 03 
			15 00 02 62 04 
			15 00 02 63 6C //CKV_ON 
			15 00 02 64 6C //CKV_OFF 
			15 00 02 65 75 
			15 00 02 66 08 //ETV_S0 
			15 00 02 67 B4 //ckv_num/ckv_w
			15 00 02 68 08 //CKV_S0
			15 00 02 69 6C //CKV_ON
			15 00 02 6A 6C //CKV_OFF 
			15 00 02 6B 0C //dummy
			15 00 02 6D 00 //GGND1 
			15 00 02 6E 00 //GGND2 
			15 00 02 6F 88 			 
			15 00 02 75 BB //FLM_EN 
			15 00 02 76 00 
			15 00 02 77 05
			15 00 02 78 2A //FLM_OFF 
			//Page4
			15 00 02 E0 04
			15 00 02 09 11
			15 00 02 0E 48	//Source EQ option
			15 00 02 2B 2B
			15 00 02 2D 03 //defult 01
			15 00 02 2E 44
			//Page5
			15 00 02 E0 05
			15 00 02 12 72//VCI GAS detect voltage
			//Page0
			15 00 02 E0 00
			15 00 02 E6 02 //WD_Timer
			15 00 02 E7 0C //WD_Timer
			05 00 01 11
			05 78 01 29
		];
        panel-init-sequence-second = [
			 39 00 04 FF 98 81 03 

