/dts-v1/;
#include "rk3288-evb.dtsi"
#include "rk3288-android.dtsi"
#include <dt-bindings/sensor-dev.h>

/ {
	compatible = "rockchip,rk3288-tpv-eposter-rk808", "rockchip,rk3288w";

	sdio_pwrseq: sdio-pwrseq {
		status = "okay";
		compatible = "mmc-pwrseq-simple";
		clocks = <&rk808 1>;
		clock-names = "ext_clock";
		pinctrl-names = "default";
		pinctrl-0 = <&wifi_enable_h>;

		/*
		 * On the module itself this is one of these (depending
		 * on the actual card populated):
		 * - SDIO_RESET_L_WL_REG_ON
		 * - PDN (power down when low)
		 */
		reset-gpios = <&gpio4 28 GPIO_ACTIVE_LOW>;
	};

	vcc_flash: vcc-flash {
		compatible = "regulator-fixed";
		regulator-name = "vcc_flash";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
	};

	/*
	vcc_wifi: vcc-wifi-regulator {
		compatible = "regulator-fixed";
		//enable-active-high;
		gpio = <&gpio5 16 GPIO_ACTIVE_LOW>;
		pinctrl-names = "default";
		pinctrl-0 = <&wl_en>;
		regulator-name = "vcc_wifi";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-always-on;
		regulator-boot-on;
	};
	*/
	wireless-wlan {
		compatible = "wlan-platdata";
		rockchip,grf = <&grf>;
		wifi_chip_type = "ap6256";
		sdio_vref =<1800>;
		WIFI,vbat_gpio = <&gpio5 16 GPIO_ACTIVE_LOW>; 
		WIFI,host_wake_irq = <&gpio4 30 GPIO_ACTIVE_HIGH>;
		status = "okay";
	};

	wireless-bluetooth {
		compatible = "bluetooth-platdata";
		clocks = <&rk808 1>;
		clock-names = "ext_clock";
		/* wifi-bt-power-toggle; */
		uart_rts_gpios = <&gpio4 19 GPIO_ACTIVE_LOW>;
		pinctrl-names = "default", "rts_gpio";
		pinctrl-0 = <&uart0_rts>,<&bt_wake>;
		pinctrl-1 = <&uart0_gpios>;
		BT,power_gpio  = <&gpio4 27 GPIO_ACTIVE_HIGH>; 
		//BT,reset_gpio    = <&gpio3 5 GPIO_ACTIVE_HIGH>;
		BT,wake_gpio     = <&gpio4 26 GPIO_ACTIVE_HIGH>;
		BT,wake_host_irq = <&gpio4 31 GPIO_ACTIVE_HIGH>;
		status = "okay";
	};


	/delete-node/ sdmmc-regulator;

	vdd_log: vdd-logic {
		compatible = "pwm-regulator";
		rockchip,pwm_id = <1>;
		rockchip,pwm_voltage = <1100000>;
		pwms = <&pwm1 0 25000 1>;
		regulator-name = "vcc_log";
		regulator-min-microvolt = <860000>;
		regulator-max-microvolt = <1360000>;
		regulator-always-on;
		regulator-boot-on;
	};

	xin32k: xin32k {
		compatible = "fixed-clock";
		clock-frequency = <32768>;
		clock-output-names = "xin32k";
		#clock-cells = <0>;
	};

	rockchip_headset {
		status = "okay";
		compatible = "rockchip_headset";
		headset_gpio = <&gpio7 15 GPIO_ACTIVE_HIGH>;
		//io-channels = <&saradc 2>;
		pinctrl-names = "default";
		pinctrl-0 = <&headset_det>;
	};

	gpio-leds {
		compatible = "gpio-leds";
		pinctrl-names = "default";
		pinctrl-0 =<&leds_gpio>;

		led-yellow {
			gpios = <&gpio7 9 GPIO_ACTIVE_LOW>;
			label = "yellow";
			retain-state-suspended;
			default-state = "on";
			linux,default-trigger = "none";
			status = "okay";
		};

		led-green {
			gpios = <&gpio7 10 GPIO_ACTIVE_LOW>;
			label = "green";
			default-state = "on";
			linux,default-trigger = "none";
			status = "okay";
		};

		slight_r {			
			gpios = <&gpio5 19 GPIO_ACTIVE_HIGH>;
			label = "light_red";
			retain-state-suspended;
			default-state = "off";
			linux,default-trigger = "none";
			status = "okay";

		};


		slight_g {			
			gpios = <&gpio5 18 GPIO_ACTIVE_HIGH>;
			label = "light_green";
			retain-state-suspended;
			default-state = "off";
			linux,default-trigger = "none";
			status = "okay";

		};

		slight_b {			
			gpios = <&gpio5 17 GPIO_ACTIVE_HIGH>;
			label = "light_blue";
			retain-state-suspended;
			default-state = "off";
			linux,default-trigger = "none";
			status = "okay";

		};
	};
};

&hdmi_analog_sound {
	status = "okay";
	rockchip,model = "realtek,rt5651-codec";
	rockchip,codec = <&rt5651>, <&hdmi>;
};

&cpu0 {
	cpu-supply = <&vdd_cpu>;
};

&cif_isp0 {
	status = "okay";
};

&dfi {
	status = "okay";
};

&dmc {
	center-supply = <&vdd_log>;
	status = "okay";
};

&rk_key {
		compatible = "rockchip,key";
		status = "okay";

		io-channels = <&saradc 1>;

		vol-up-key {
			linux,code = <115>;
			label = "volume up";
			rockchip,adc_value = <1>;
		};

		vol-down-key {
			linux,code = <114>;
			label = "volume down";
			rockchip,adc_value = <170>;
		};
		/*
		power-key {
			gpios = <&gpio5 13 GPIO_ACTIVE_LOW>;
			linux,code = <116>;
			pinctrl-names = "default";
			pinctrl-0 = <&pwrbtn>;
			label = "power";
			gpio-key,wakeup;
		};
		*/
		reset-key {
			gpios = <&gpio7 7 GPIO_ACTIVE_LOW>;
			linux,code = <249>;
			pinctrl-names = "default";
			pinctrl-0 = <&rstbtn>;
			label = "reset";
			gpio-key;
		};

		menu-key {
			gpios = <&gpio5 13 GPIO_ACTIVE_LOW>;
			linux,code = <59>;
			pinctrl-names = "default";
			pinctrl-0 = <&menubtn>;
			label = "menu";
			gpio-key;
		};

/*		home-key {
			linux,code = <102>;
			label = "home";
			rockchip,adc_value = <746>;
		};

		back-key {
			linux,code = <158>;
			label = "back";
			rockchip,adc_value = <560>;
		};

		camera-key {
			linux,code = <212>;
			label = "camera";
			rockchip,adc_value = <450>;
		};
*/
	};

&edp {
	status = "disabled";
};

